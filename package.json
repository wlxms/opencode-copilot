{
  "name": "opencode-copilot",
  "displayName": "OpenCode Copilot",
  "version": "0.1.0",
  "description": "AI coding assistant powered by OpenCode",
  "engines": {
    "vscode": "^1.118.0"
  },
  "enabledApiProposals": [
    "chatParticipantAdditions",
    "chatParticipantPrivate",
    "chatSessionsProvider"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "icons": {
      "opencode-logo": {
        "description": "OpenCode brand logomark",
        "default": {
          "fontPath": "./resources/font-icons/opencode-icon.woff",
          "fontCharacter": "\\E001"
        }
      }
    },
    "commands": [
      {
        "command": "opencode.openSettings",
        "title": "ACP: Open Settings",
        "category": "ACP"
      }
    ],
    "languageModelChatProviders": [
      {
        "vendor": "opencode-cli",
        "displayName": "OpenCode CLI",
        "managementCommand": "opencode.openSettings"
      },
      {
        "vendor": "opencode-zen",
        "displayName": "OpenCode Zen",
        "managementCommand": "opencode.openSettings"
      }
    ],
    "configuration": {
      "title": "OpenCode",
      "properties": {
        "opencode.experimental.sessionProvider": {
          "type": "boolean",
          "default": false,
          "description": "Enable the experimental ACP-compatible VS Code chat session provider surface when the runtime exposes the required proposed API."
        },
        "opencode.experimental.acpBackendModelSupport": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, ACP backend-specific models (e.g. OpenCode Zen/Go) are registered with sessionOnly=false so they appear in all Copilot session targets. Non-specific models get sessionOnly=true (opencode target only). When disabled, all models get sessionOnly=true."
        },
        "opencode.experimental.acpModelBridge": {
          "type": "boolean",
          "default": false,
          "description": "[Experimental] Enable ACP Model Bridge — bridges ACP backend models into Copilot's native model picker with full vendor isolation. (Not yet implemented)"
        }
      }
    },
    "chatSessions": [
      {
        "type": "opencode-copilot.opencode",
        "name": "opencode",
        "displayName": "OpenCode",
        "description": "AI coding agent powered by OpenCode",
        "icon": "$(opencode-logo)",
        "inputPlaceholder": "Ask OpenCode anything...",
        "canDelegate": true,
        "requiresCustomModels": true,
        "capabilities": {
          "supportsFileAttachments": true,
          "supportsToolAttachments": true,
          "supportsImageAttachments": true
        },
        "commands": [
          {
            "name": "new",
            "description": "Start a new conversation session"
          },
          {
            "name": "help",
            "description": "Show available commands"
          },
          {
            "name": "model",
            "description": "Show or change the current model"
          },
          {
            "name": "test-external-edit",
            "description": "Test externalEdit bubble push"
          },
          {
            "name": "test-external-edit-real",
            "description": "Test externalEdit with direct disk write (simulates server)"
          },
          {
            "name": "test-external-edit-e2e",
            "description": "End-to-end test via real OpenCode prompt"
          },
          {
            "name": "test-subagent-single-blocking",
            "description": "Diagnostic: single subagent, blocking (pending→running→completed)"
          },
          {
            "name": "test-subagent-multi-blocking",
            "description": "Diagnostic: multiple subagents, sequential blocking"
          },
          {
            "name": "test-subagent-single-parallel",
            "description": "Diagnostic: single subagent, parallel/callback pattern"
          },
          {
            "name": "test-subagent-multi-parallel",
            "description": "Diagnostic: multi subagents, all parallel"
          },
          {
            "name": "test-file-read-stream",
            "description": "Run file-bubble lifecycle experiment matrix"
          },
          {
            "name": "test-stream-latency",
            "description": "Diagnostic: measure streaming event latency from backend (delta timing + batch detection)"
          },
          {
            "name": "test-thinking",
            "description": "Diagnostic: verify thinkingProgress API and reasoning/text boundary rendering"
          },
          {
            "name": "test-question",
            "description": "Diagnostic: test questionCarousel UI flow (single-select, multi-select, text input)"
          },
          {
            "name": "test-question-full",
            "description": "Test questionCarousel UI flow (single-select, multi-select, text input)"
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src/",
    "lint:all": "tsc --noEmit && eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "generate-font": "node scripts/generate-font.cjs",
    "vscode:prepublish": "npm run generate-font && npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.40",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "esbuild": "^0.24.2",
    "eslint": "^10.4.0",
    "fantasticon": "^4.1.0",
    "glob": "^13.0.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.81",
    "@ai-sdk/google": "^3.0.80",
    "@ai-sdk/openai": "^3.0.67",
    "@ai-sdk/openai-compatible": "^2.0.48",
    "@opencode-ai/sdk": "^1.15.10",
    "ai": "^6.0.193"
  }
}
